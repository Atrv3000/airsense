# Django Security & Environment
SECRET_KEY=replace-with-a-secure-random-key-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,192.168.0.100,*

# PostgreSQL Database Configuration
DB_NAME=airsense_db
DB_USER=postgres
DB_PASSWORD=your_production_password
DB_HOST=localhost
DB_PORT=5432

# Ingestion & External APIs
OPEN_METEO_AQ_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Security Settings (Set to True behind HTTPS Reverse Proxy)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
